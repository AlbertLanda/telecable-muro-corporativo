# Desarrollo local; producción usa HTTPS y PostgreSQL.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_USE_SQLITE=1
POSTGRES_DB=telecable_muro
POSTGRES_USER=telecable_muro
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
# En producción configura también estas variables privadas:
# DJANGO_SECRET_KEY=
# DJANGO_MEDIA_ROOT=/var/lib/telecable-muro/media
# DJANGO_TRUST_PROXY=1
